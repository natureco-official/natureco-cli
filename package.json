{
  "name": "natureco-cli",
  "version": "6.0.0",
  "description": "Terminal-native AI agent CLI with bilingual TR/EN UI, multi-agent orchestration, persistent memory, secure tools and messaging integrations.",
  "bin": {
    "natureco": "bin/natureco.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "README.md",
    "SELF.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "SKILL_PROVENANCE.json",
    "SBOM.cdx.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "perf:startup": "node scripts/benchmark-startup.js",
    "provenance:generate": "node scripts/generate-skill-provenance.js",
    "provenance:check": "node scripts/generate-skill-provenance.js --check",
    "sbom:generate": "node scripts/generate-sbom.js",
    "sbom:check": "node scripts/generate-sbom.js --check",
    "audit:deps": "node scripts/audit-dependencies.js",
    "lint": "eslint src/ bin/ test/ scripts/ --max-warnings=356",
    "lint:fix": "eslint src/ bin/ test/ scripts/ --fix",
    "lint:errors-only": "eslint src/ bin/ test/ scripts/ --quiet",
    "smoke": "node --check bin/natureco.js && node bin/natureco.js help",
    "smoke:context": "node scripts/e2e-context-smoke.js",
    "smoke:browser": "node scripts/e2e-browser-smoke.js",
    "prepublishOnly": "npm run validate:release",
    "validate:release": "node --check bin/natureco.js && npm run lint && npm test -- --reporter=dot && npm run smoke && npm run perf:startup && npm run provenance:check && npm run sbom:check && npm run audit:deps"
  },
  "keywords": [
    "natureco",
    "ai",
    "ai-agent",
    "bot",
    "cli",
    "terminal",
    "openclaw-alternative",
    "claude-code-alternative",
    "multi-agent",
    "self-evolving-skills",
    "audit-log",
    "cost-optimization",
    "seo",
    "türkçe",
    "turkish",
    "whatsapp-bot",
    "telegram-bot",
    "discord-bot",
    "natureco-me"
  ],
  "author": {
    "name": "Gencay Olgun",
    "email": "hello@natureco.me",
    "url": "https://natureco.me"
  },
  "homepage": "https://natureco.me/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natureco-official/natureco-cli.git"
  },
  "bugs": {
    "url": "https://github.com/natureco-official/natureco-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@inquirer/prompts": "^8.5.2",
    "@slack/web-api": "^8.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "diff": "^5.2.2",
    "discord.js": "^14.27.0",
    "irc": "^0.5.2",
    "marked": "^4.3.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^1.1.2",
    "openai": "^6.45.0",
    "pino": "^8.21.0",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.8.1",
    "string-width": "^4.2.3",
    "twilio": "^6.0.2",
    "urdr-mcp-server": "^1.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^17.8.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "6.28.0",
    "urdr-mcp-server": {
      "@modelcontextprotocol/sdk": "1.30.0"
    },
    "@hono/node-server": "2.1.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "hono": "4.13.1",
    "ip-address": "10.5.0",
    "nanoid": "3.3.17"
  }
}
